# Note: Basic-Auth via _headers requires a Netlify Pro plan and is not
# functional on the Free plan. Rules removed 2026-07-26 since they were
# silently being ignored. Full review copies are kept as unlisted URLs
# instead (not linked from site nav) rather than true password protection.

# Trade/wholesale material: reachable only by direct link, kept out of search engines.
/*.pdf
  X-Robots-Tag: noindex, nofollow
/wholesale-order*
  X-Robots-Tag: noindex, nofollow
/*reviewer*
  X-Robots-Tag: noindex, nofollow
/*buyerreview*
  X-Robots-Tag: noindex, nofollow

# Faire product images: reachable by direct link only, kept out of search engines.
/faire-images/*
  X-Robots-Tag: noindex, nofollow

# Syncee product feed (stable URL, always fresh)
/feeds/*
  Content-Type: text/csv; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

# Private Tesla flipbook: direct link only, kept out of search engines.
/tesla/*
  X-Robots-Tag: noindex, nofollow
/tesla/pages/*
  Cache-Control: public, max-age=31536000, immutable

